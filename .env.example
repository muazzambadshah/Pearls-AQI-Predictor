# Copy to `.env` and edit. Every setting has a working default - the project
# runs end to end with this file absent, using free APIs and a local parquet
# feature store, with no accounts and no keys.

# --- Location -------------------------------------------------------------
CITY_NAME=Lahore
CITY_LAT=31.5497
CITY_LON=74.3436
TIMEZONE=Asia/Karachi

# --- Forecast problem -----------------------------------------------------
FORECAST_HORIZON_DAYS=3

# Earliest date to backfill. Open-Meteo's air-quality archive returns rows before
# this but leaves `us_aqi` null, so this is where the target actually begins.
HISTORY_START_DATE=2023-01-01

# --- Data source ----------------------------------------------------------
# open_meteo (default) needs no key and provides both archive and forecast.
# aqicn gives a current reading only; a free token comes from https://aqicn.org/api/
DATA_SOURCE=open_meteo
AQICN_TOKEN=

# --- Feature store --------------------------------------------------------
# local (default) = parquet on disk. hopsworks = managed feature store.
FEATURE_STORE_BACKEND=local
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=

# --- Training -------------------------------------------------------------
TEST_FRACTION=0.2
N_BACKTEST_FOLDS=4

# Cap on rows in the horizon-expanded dataset. Each origin fans out into one row
# per horizon, so three years of hourly history at 72 horizons is ~1.9M rows;
# this bound keeps the frame inside a 16GB machine. Raise it if you have more.
MAX_TRAIN_ROWS=250000
RANDOM_SEED=42

# Include the PyTorch candidate. Requires `pip install torch`; the pipeline
# detects its absence and skips it rather than failing.
ENABLE_DEEP_MODEL=0

# Include the TensorFlow/Keras candidate alongside the PyTorch one. Requires
# `pip install tensorflow-cpu` (already in requirements.txt); the pipeline
# detects its absence and skips it rather than failing.
ENABLE_TF_MODEL=0

# --- Alerts ---------------------------------------------------------------
ALERT_AQI_THRESHOLD=150
# Slack-compatible incoming webhook. Left blank, alerts are logged only.
ALERT_WEBHOOK_URL=
